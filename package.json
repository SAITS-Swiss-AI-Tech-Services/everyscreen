{
  "name": "everyscreen",
  "version": "0.1.0",
  "description": "Every screen of your Expo Router app on one reviewable canvas: routes and links from the code, screenshots from your devices, comments from your team. With an MCP server for AI agents. By SAITS.",
  "license": "MIT",
  "author": "SAITS (https://saits.ai)",
  "type": "module",
  "bin": {
    "everyscreen": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "screenshots",
    "design-review",
    "mcp",
    "cli"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build --config ui/vite.config.ts && node scripts/bundle.mjs",
    "dev": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "demo": "node dist/cli.js serve --project examples/trailmix --open",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-sqlite3": "13.0.3",
    "sirv": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xyflow/react": "12.12.0",
    "html-to-image": "1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
